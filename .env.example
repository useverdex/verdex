# Copy to .env for local builds. Every variable is optional.

# LI.FI API key. The public li.quest API rate-limits by IP; with a key, it is sent as x-lifi-api-key
# on every quote and token-list request. Read at build time.
VITE_LIFI_API_KEY=

# Verdex fee on Auto-Invest buys and vault rebalance trades for wallets that do not hold VERDEX,
# as a fraction of the trade. Holders always pay zero. Default 0.0025 (0.25%).
VITE_VERDEX_FEE=

# Set by the preview build script: serve from a relative base and use hash routing.
# VITE_BASE=./
# VITE_HASH_ROUTER=1
# VITE_LOGO_PACK=1

# Auto-Invest without you: the deployed VerdexAutoInvest contract on Robinhood Chain. Empty hides the composer.
VITE_AUTOINVEST_ADDRESS=
VITE_INDEX_FACTORY_ADDRESS=
VITE_INDEX_ROUTER_ADDRESS=
VITE_TREASURY_ADDRESS=
# Verdex Lend contract on Robinhood Chain (optional; the built-in address in scripts/lend-address.mjs is used otherwise)
VITE_LEND_ADDRESS=
